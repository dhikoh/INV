{
  "name": "omnicat",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node scripts/prepare-standalone.js",
    "build:clean": "node scripts/clean-next.js && next build && node scripts/prepare-standalone.js",
    "clean:next": "node scripts/clean-next.js",
    "start": "next start",
    "start:standalone": "node scripts/prepare-standalone.js && node .next/standalone/server.js",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "test:unit": "vitest run tests/unit",
    "test:int": "vitest run tests/integration",
    "test:coverage": "vitest run --coverage",
    "db:seed": "tsx prisma/seed.ts",
    "worker": "tsx src/worker/index.ts",
    "release:draft": "tsx scripts/release-draft.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "argon2": "0.45.2",
    "exceljs": "^4.4.0",
    "fflate": "^0.8.3",
    "grammy": "^1.46.0",
    "lucide-react": "0.475.0",
    "next": "15.5.29",
    "pg": "8.23.1",
    "pg-boss": "^12.38.1",
    "pino": "9.6.0",
    "puppeteer-core": "^25.16.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "sharp": "0.35.5",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.15",
    "@playwright/test": "1.50.1",
    "@types/node": "22.13.4",
    "@types/pg": "8.23.1",
    "@types/react": "19.0.8",
    "@types/react-dom": "19.0.4",
    "@vitest/coverage-v8": "3.0.5",
    "autoprefixer": "10.4.20",
    "eslint": "9.20.1",
    "eslint-config-next": "15.5.29",
    "postcss": "8.5.32",
    "prettier": "3.5.1",
    "prisma": "7.10.1",
    "tailwindcss": "3.4.17",
    "tsx": "4.23.15",
    "typescript": "5.7.3",
    "vitest": "3.0.5"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
