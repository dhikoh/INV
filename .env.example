# OMNICAT ENTERPRISE - ENVIRONMENT CONFIGURATION
DATABASE_PATH=data/omnicat_local.db

# Cryptographic Keys (MUST change in production to a secure 32+ character random string)
OMNICAT_JWT_SECRET=generate-a-cryptographically-secure-random-secret-key-32-chars

# Telegram Bot Token (from @BotFather for TMA HMAC-SHA256 validation)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ

# Server Bindings & Domain
HOST=0.0.0.0
PORT=8000
APP_DOMAIN=modula.click
ENVIRONMENT=production

