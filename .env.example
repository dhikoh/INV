# .env.example (jangan isi nilai asli di file ini)
DATABASE_URL=postgresql://app:app@localhost:5432/app
TEST_DATABASE_URL=postgresql://app:app@localhost:5433/app_test
APP_URL=https://app.contoh.com
SESSION_COOKIE_NAME=sid
SESSION_TTL_DAYS=7
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_MB=5
# Batas maksimal ukuran berkas ZIP ekspor/impor data dalam megabyte (default 200 MB)
TRANSFER_MAX_MB=200
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_USERNAME=
APP_SECRET=
SEED_SUPERADMIN_USERNAME=
SEED_SUPERADMIN_PASSWORD=
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
TZ=Asia/Jakarta
LOG_LEVEL=info
